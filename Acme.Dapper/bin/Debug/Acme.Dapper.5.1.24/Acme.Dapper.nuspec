<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Acme.Dapper</id>
    <version>5.1.24</version>
    <authors>yzxs</authors>
    <description>Acme框架基于Dapper的数据库操作类库</description>
    <copyright>yzxs</copyright>
    <dependencies>
      <group targetFramework="net6.0">
        <dependency id="Acme" version="5.1.24" exclude="Build,Analyzers" />
        <dependency id="Dapper" version="2.0.123" exclude="Build,Analyzers" />
        <dependency id="Dapper.Contrib" version="2.0.78" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Data.SqlClient" version="5.1.1" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Extensions.DependencyInjection" version="7.0.0" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net7.0">
        <dependency id="Acme" version="5.1.24" exclude="Build,Analyzers" />
        <dependency id="Dapper" version="2.0.123" exclude="Build,Analyzers" />
        <dependency id="Dapper.Contrib" version="2.0.78" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Data.SqlClient" version="5.1.1" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Extensions.DependencyInjection" version="7.0.0" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>