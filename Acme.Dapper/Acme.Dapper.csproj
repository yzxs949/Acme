<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net9.0;net10.0;net11.0;</TargetFrameworks>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<Version>5.7.1</Version>
		<Authors>yzxs</Authors>
		<Company>yzxs</Company>
		<Copyright>yzxs</Copyright>
		<Description>Acme framework based on Dapper database operation class library</Description>
		<PackageTags>Acme;Dapper;Acme.Dapper;yzxs;云中小生;.NET8;.NET9;.NET10;.NET11</PackageTags>
		<PackageProjectUrl>https://gitee.com/yzxs949/acme</PackageProjectUrl>
		<RepositoryUrl>https://gitee.com/yzxs949/acme</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReleaseNotes>
			1. 新增 net11.0 目标框架支持
			2. Microsoft.Data.SqlClient 升级到 7.1.2
			3. Microsoft.Extensions.DependencyInjection 升级到 11.0.0
		</PackageReleaseNotes>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Dapper" Version="2.1.89" />
		<PackageReference Include="Dapper.Contrib" Version="2.0.78" />
		<PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.2" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Acme\Acme.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

</Project>
