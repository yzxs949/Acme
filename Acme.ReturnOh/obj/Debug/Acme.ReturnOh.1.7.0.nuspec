        <dependency id="Swashbuckle.AspNetCore.SwaggerUI" version="10.0.1" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net10.0">
        <dependency id="Swashbuckle.AspNetCore.Swagger" version="10.0.1" exclude="Build,Analyzers" />
        <dependency id="Swashbuckle.AspNetCore.SwaggerGen" version="10.0.1" exclude="Build,Analyzers" />
        <dependency id="Swashbuckle.AspNetCore.SwaggerUI" version="10.0.1" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
