      </group>
      <group targetFramework="net8.0">
        <dependency id="Swashbuckle.AspNetCore.Swagger" version="7.2.0" exclude="Build,Analyzers" />
        <dependency id="Swashbuckle.AspNetCore.SwaggerGen" version="7.2.0" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net9.0">
        <dependency id="Swashbuckle.AspNetCore.Swagger" version="7.2.0" exclude="Build,Analyzers" />
        <dependency id="Swashbuckle.AspNetCore.SwaggerGen" version="7.2.0" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
