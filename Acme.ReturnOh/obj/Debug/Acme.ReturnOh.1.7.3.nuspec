        <dependency id="Swashbuckle.AspNetCore.SwaggerUI" version="10.1.5" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net10.0">
        <dependency id="Microsoft.OpenApi" version="3.4.0" exclude="Build,Analyzers" />
        <dependency id="Swashbuckle.AspNetCore.Swagger" version="10.1.5" exclude="Build,Analyzers" />
