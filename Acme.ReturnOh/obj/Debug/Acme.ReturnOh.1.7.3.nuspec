        <dependency id="Swashbuckle.AspNetCore.SwaggerGen" version="10.1.5" exclude="Build,Analyzers" />
        <dependency id="Swashbuckle.AspNetCore.SwaggerUI" version="10.1.5" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net9.0">
