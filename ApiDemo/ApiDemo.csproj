<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
	  <PackageReference Include="Acme.ReturnOh" Version="1.7.4" />
	  <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.25" />
  </ItemGroup>
  <Target Name="CopyNuGetXmlToOutput" AfterTargets="Build">
		<ItemGroup>
			<NuGetXmlFile Include="@(ReferenceCopyLocalPaths-&gt;WithMetadataValue('NuGetPackageId','Acme.ReturnOh'))" />
		</ItemGroup>

		<Copy SourceFiles="%(NuGetXmlFile.RootDir)%(NuGetXmlFile.Directory)%(NuGetXmlFile.Filename).xml" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" Condition="Exists('%(NuGetXmlFile.RootDir)%(NuGetXmlFile.Directory)%(NuGetXmlFile.Filename).xml')" />
	</Target>
   

</Project>
