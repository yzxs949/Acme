<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8;net9;</TargetFrameworks>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<Version>5.5.1.3</Version>
		<Authors>yzxs</Authors>
		<Company>yzxs</Company>
		<Copyright>yzxs</Copyright>
		<Description>
			Acme 让.NET开发更简单、更便捷
		</Description>
		<PackageTags>Acme;类库;yzxs;云中小生;net8;net9;</PackageTags>
	</PropertyGroup>

	<ItemGroup>
	  <None Remove="nlog.config" />
	</ItemGroup>

	<ItemGroup>
	  <EmbeddedResource Include="nlog.config">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </EmbeddedResource>
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Caching.Abstractions" Version="9.0.0" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
		<PackageReference Include="Microsoft.Extensions.Features" Version="9.0.0" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
		<PackageReference Include="NLog" Version="5.3.4" />
		<PackageReference Include="NPOI" Version="2.7.2" />
		<PackageReference Include="NuGet.Build.Tasks.Pack" Version="6.12.1">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Swashbuckle.AspNetCore" Version="7.2.0" />
		<PackageReference Include="ZKWeb.System.Drawing" Version="4.0.1" />
	</ItemGroup>
	<ItemGroup>
	  <None Update="Nlogs\nlog.config">
	    <CopyToOutputDirectory>Never</CopyToOutputDirectory>
	  </None>
	</ItemGroup>





</Project>