<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net9.0;net10.0;</TargetFrameworks>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<Version>5.6.8.1</Version>
		<Authors>云中小生</Authors>
		<Company>云中小生</Company>
		<Copyright>云中小生</Copyright>
		<Description>
			Acme 极简 .NET 开发，高效触手可及
		</Description>
		<PackageTags>Acme;类库;yzxs;云中小生;.NET8;.NET9;.NET10</PackageTags>
		<PackageProjectUrl>https://gitee.com/yzxs949/acme</PackageProjectUrl>
		<RepositoryUrl>https://gitee.com/yzxs949/acme</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReleaseNotes>
			一、安全加固
				1.Cookie 设置默认开启 HttpOnly 与 SameSite=Lax，缓解 XSS 窃取与 CSRF（新增 httpOnly 可选参数）
			二、修复缺陷
				1.Excel 导入/导出修复 Stream、IWorkbook、FileStream 资源泄漏
				2.Excel 导入修复空行导致的空引用异常，自动跳过空行
				3.Excel 导入修复文件后缀大小写敏感问题（.XLSX 等大写后缀无法导入）
				4.Excel 导入类型转换改为安全转换，单个单元格转换失败不再中断整表导入
				5.Excel 导出增加空数据、缺失工作表校验
				6.修复 HttpHelper 资源释放、超时缺失、状态码未校验、序列化不一致等问题
				7.修复 App.Path 注释错误
			三、代码优化
				1.重构 Swagger 配置，提取公共逻辑消除重复代码
				2.移除未使用的 using 与冗余代码
		</PackageReleaseNotes>
		<AcceptNPOIOSMFLicense>true</AcceptNPOIOSMFLicense>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="Image\二维码.jpg" />
		<None Remove="nlog.config" />
		<None Remove="README.md" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Image\二维码.jpg">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</EmbeddedResource>
		<EmbeddedResource Include="nlog.config">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</EmbeddedResource>
		<EmbeddedResource Include="README.md">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</EmbeddedResource>
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="NuGet.Build.Tasks.Pack" Version="6.14.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="NPOI" Version="2.8.1" />
		<PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.3.1" />
		<PackageReference Include="Swashbuckle.AspNetCore.Swagger" Version="10.3.1" />
		<PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" Version="10.3.1" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="ZKWeb.System.Drawing" Version="4.0.1" />
		<PackageReference Include="Microsoft.Extensions.Caching.Abstractions" Version="10.0.14" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
		<PackageReference Include="Microsoft.Extensions.Features" Version="10.0.14" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.33" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.22" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
	</ItemGroup>
</Project>