<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net9.0;net10.0;net11.0;</TargetFrameworks>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<Version>5.6.9</Version>
		<Authors>云中小生</Authors>
		<Company>云中小生</Company>
		<Copyright>云中小生</Copyright>
		<Description>
			Acme 极简 .NET 开发，高效触手可及
		</Description>
		<PackageTags>Acme;类库;yzxs;云中小生;.NET8;.NET9;.NET10;.NET11</PackageTags>
		<PackageProjectUrl>https://gitee.com/yzxs949/acme</PackageProjectUrl>
		<RepositoryUrl>https://gitee.com/yzxs949/acme</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReleaseNotes>
			1.新增 net11.0 目标框架支持
			2.Microsoft.Extensions.* 升级到 11.0.0
			3.JwtBearer 分别升级到 8.0.34 / 9.0.23 / 10.0.15 / 11.0.0
			4.Swashbuckle 按目标框架区分：net8.0 / net9.0 使用 10.3.1，net10.0 / net11.0 使用 11.0.1
		</PackageReleaseNotes>
		<AcceptNPOIOSMFLicense>true</AcceptNPOIOSMFLicense>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="Image\二维码.jpg" />
		<None Remove="nlog.config" />
		<None Remove="README.md" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Image\二维码.jpg">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</EmbeddedResource>
		<EmbeddedResource Include="nlog.config">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</EmbeddedResource>
		<EmbeddedResource Include="README.md">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</EmbeddedResource>
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="NuGet.Build.Tasks.Pack" Version="6.14.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="NPOI" Version="2.8.1" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="ZKWeb.System.Drawing" Version="4.0.1" />
		<PackageReference Include="Microsoft.Extensions.Caching.Abstractions" Version="11.0.0" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
		<PackageReference Include="Microsoft.Extensions.Features" Version="11.0.0" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.34" />
		<PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.3.1" />
		<PackageReference Include="Swashbuckle.AspNetCore.Swagger" Version="10.3.1" />
		<PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" Version="10.3.1" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.23" />
		<PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.3.1" />
		<PackageReference Include="Swashbuckle.AspNetCore.Swagger" Version="10.3.1" />
		<PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" Version="10.3.1" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15" />
		<PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="11.0.1" />
		<PackageReference Include="Swashbuckle.AspNetCore.Swagger" Version="11.0.1" />
		<PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" Version="11.0.1" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="11.0.0" />
		<PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="11.0.1" />
		<PackageReference Include="Swashbuckle.AspNetCore.Swagger" Version="11.0.1" />
		<PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" Version="11.0.1" />
	</ItemGroup>
</Project>